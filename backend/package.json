{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:stage-a": "prettier --write src/app.module.ts src/features/audit/audit.module.ts src/features/audit/audit.service.spec.ts src/features/audit/audit.service.ts src/features/audit/audit.types.ts src/features/audit/health.controller.spec.ts src/features/audit/health.controller.ts src/shared/errors/app-error.spec.ts src/shared/errors/app-error.ts src/shared/errors/http-exception.filter.ts src/shared/errors/sensitive-fields.spec.ts src/shared/errors/sensitive-fields.ts src/shared/logging/logger.service.spec.ts src/shared/logging/logger.service.ts src/shared/trace/trace.context.spec.ts src/shared/trace/trace.context.ts src/shared/trace/trace.middleware.ts test/http/exception-filter.spec.ts test/http/internal-error.spec.ts test/http/trace-middleware.spec.ts",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "NODE_ENV=test CSRF_SECRET=test-secret-key vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:cov": "NODE_ENV=test CSRF_SECRET=test-secret-key vitest run --coverage",
    "test:debug": "NODE_ENV=test CSRF_SECRET=test-secret-key vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "NODE_ENV=test CSRF_SECRET=test-secret-key vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/google": "^0.2.12",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "multer": "2.5.0",
    "esbuild": "0.28.2"
  }
}
